{
  "name": "@choicemind/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "smoke:coremind:qwen": "tsx scripts/smoke-coremind-qwen.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.scripts.json"
  },
  "dependencies": {
    "@choicemind/contracts": "workspace:*",
    "@choicemind/task-persistence": "workspace:*",
    "coremind-ai": "0.3.0",
    "fastify": "5.11.3"
  },
  "devDependencies": {
    "@redis/client": "6.2.1"
  }
}
