{
  "name": "@choicemind/source-access",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run --exclude tests/integration/** --passWithNoTests",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@choicemind/security": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@choicemind/task-persistence": "workspace:*",
    "@types/pg": "8.23.1"
  }
}
