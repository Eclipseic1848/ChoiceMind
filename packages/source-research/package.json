{
  "name": "@choicemind/source-research",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./candidate-runtime": {
      "types": "./src/candidate-runtime.ts",
      "default": "./dist/candidate-runtime.js"
    },
    "./adapter-candidate": {
      "types": "./src/adapter-candidate.ts",
      "default": "./dist/adapter-candidate.js"
    },
    "./candidate-store": {
      "types": "./src/candidate-store.ts",
      "default": "./dist/candidate-store.js"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run --exclude tests/integration/** --passWithNoTests",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@redis/client": "6.2.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
